{
    "layout-section": {
        "type": "section",
        "description": "Layout"
    },
    "gap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Gap between windows"
    },
    "new-window-width": {
        "type": "combobox",
        "default": 0.5,
        "options": {
            "Keep the app's own width": 0,
            "One third": 0.3333,
            "Half": 0.5,
            "Two thirds": 0.6667
        },
        "description": "Width of new windows"
    },
    "animate": {
        "type": "switch",
        "default": true,
        "description": "Animate scrolling"
    },
    "animation-time": {
        "type": "spinbutton",
        "default": 200,
        "min": 50,
        "max": 1000,
        "step": 10,
        "units": "ms",
        "description": "Animation duration",
        "dependency": "animate"
    },
    "keys-section": {
        "type": "section",
        "description": "Keyboard shortcuts"
    },
    "key-focus-left": {
        "type": "keybinding",
        "default": "<Super>comma",
        "description": "Focus window to the left"
    },
    "key-focus-right": {
        "type": "keybinding",
        "default": "<Super>period",
        "description": "Focus window to the right"
    },
    "key-move-left": {
        "type": "keybinding",
        "default": "<Super><Shift>comma",
        "description": "Move window left in the strip"
    },
    "key-move-right": {
        "type": "keybinding",
        "default": "<Super><Shift>period",
        "description": "Move window right in the strip"
    },
    "key-focus-first": {
        "type": "keybinding",
        "default": "<Super>Home",
        "description": "Focus first window"
    },
    "key-focus-last": {
        "type": "keybinding",
        "default": "<Super>End",
        "description": "Focus last window"
    },
    "key-cycle-width": {
        "type": "keybinding",
        "default": "<Super>r",
        "description": "Cycle window width (1/3, 1/2, 2/3)"
    },
    "key-full-width": {
        "type": "keybinding",
        "default": "<Super>f",
        "description": "Toggle full width"
    },
    "key-center": {
        "type": "keybinding",
        "default": "<Super><Alt>c",
        "description": "Center focused window"
    },
    "key-toggle-float": {
        "type": "keybinding",
        "default": "<Super>t",
        "description": "Toggle tiling for focused window (float)"
    },
    "gesture-section": {
        "type": "section",
        "description": "Touchpad gestures"
    },
    "gesture-fingers": {
        "type": "combobox",
        "default": 3,
        "options": {
            "Off": 0,
            "3 fingers": 3,
            "4 fingers": 4
        },
        "description": "Swipe left/right to scroll the strip",
        "tooltip": "Replaces Cinnamon's own left/right swipe action for this finger count. Up/down swipes are untouched."
    },
    "gesture-speed": {
        "type": "spinbutton",
        "default": 1.0,
        "min": 0.25,
        "max": 4.0,
        "step": 0.25,
        "units": "screens per swipe",
        "description": "Swipe distance",
        "dependency": "gesture-fingers!=0"
    },
    "gesture-natural": {
        "type": "switch",
        "default": true,
        "description": "Natural direction (strip follows fingers)",
        "dependency": "gesture-fingers!=0"
    }
}